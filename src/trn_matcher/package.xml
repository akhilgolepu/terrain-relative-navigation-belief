<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trn_matcher</name>
  <version>0.0.0</version>
  <description>Tile store, terrain matching, absolute fix with diagnostics</description>
  <maintainer email="178921788+akhilgolepu@users.noreply.github.com">akhil</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>trn_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
